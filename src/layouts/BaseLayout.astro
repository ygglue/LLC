---
import { ClientRouter } from 'astro:transitions';
// Self-hosted fonts: Cormorant Garamond (display serif) + Inter (variable sans).
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource-variable/inter';
import 'lenis/dist/lenis.css';
import { SITE_NAME } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  /** Emit robots noindex and skip canonical (internal / error pages). */
  noindex?: boolean;
}
const { title, description, canonical, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? 'https://n3mo1101.github.io').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#F7F3EC" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <slot name="head" />
    <ClientRouter />
    <style>
      /* Page transition: a quiet 0.5s cross-fade only (no movement). */
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 0.5s;
        animation-timing-function: cubic-bezier(0.22, 0.61, 0.36, 1);
      }
      ::view-transition-old(root) {
        animation-name: page-fade-out;
      }
      ::view-transition-new(root) {
        animation-name: page-fade-in;
      }
      @keyframes page-fade-out {
        to {
          opacity: 0;
        }
      }
      @keyframes page-fade-in {
        from {
          opacity: 0;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        ::view-transition-old(root),
        ::view-transition-new(root) {
          animation: none;
        }
      }
    </style>
  </head>
  <body>
    <slot name="nav" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      // Scroll reveal (Island-free, tiny inline enhancer).
      // Re-runs on every view-transition navigation so swapped-in
      // pages always reveal instead of staying invisible.
      function initReveal() {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const els = document.querySelectorAll('[data-reveal]:not(.is-visible)');
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                const el = e.target;
                const delay = el.getAttribute('data-reveal-delay');
                if (delay) el.style.transitionDelay = `${Number(delay) * 120}ms`;
                el.classList.add('is-visible');
                io.unobserve(el);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      }
      initReveal();
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <script>
      // Lenis smooth wheel scrolling. Recreated per page so it always measures the
      // swapped-in document; skipped entirely under prefers-reduced-motion.
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;
      const root = document.documentElement;
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

      // The fullscreen menu locks scroll with a class on <html>; mirror it in Lenis.
      const lockObserver = new MutationObserver(() => {
        if (!lenis) return;
        if (root.classList.contains('menu-scroll-lock')) lenis.stop();
        else lenis.start();
      });
      lockObserver.observe(root, { attributes: true, attributeFilter: ['class'] });

      function navOffset() {
        const nav = parseFloat(getComputedStyle(root).getPropertyValue('--nav-height')) || 72;
        return -(nav + 16);
      }

      function destroyLenis() {
        lenis?.destroy();
        lenis = null;
      }

      function initLenis() {
        destroyLenis();
        if (motion.matches) return;
        lenis = new Lenis({
          autoRaf: true,
          lerp: 0.1,
          anchors: { offset: navOffset() },
        });
        if (root.classList.contains('menu-scroll-lock')) lenis.stop();
      }

      document.addEventListener('astro:page-load', initLenis);
      document.addEventListener('astro:before-swap', destroyLenis);
      motion.addEventListener('change', initLenis);
    </script>
    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </body>
</html>
