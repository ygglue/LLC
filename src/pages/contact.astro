---
import Ornament from '../components/Ornament.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactInfoCard from '../components/ContactInfoCard.astro';
import Button from '../components/Button.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import { link, PHONE_DISPLAY, PHONE_HREF, EMAIL, HOURS, AREA } from '../lib/site';
---

<BaseLayout
  title="Contact Us | Luxury Duo Cleaning LLC Orlando FL"
  description="Contact Luxury Duo Cleaning LLC in Orlando FL. Ask a question or schedule a cleaning service — we respond within hours. Call, email, or send a message today."
>
  <Nav slot="nav" />

  <PageHero
    eyebrow="Contact"
    title="Get in Touch"
    lead="Have a question or ready to schedule? We respond within hours, not days."
  />

  <section class="py-24 md:py-32">
    <div class="container-lux grid items-start gap-16 lg:grid-cols-12 lg:gap-16">
      <div class="border border-line bg-paper p-6 sm:p-10 md:p-14 lg:col-span-7" data-reveal>
        <ContactForm />
      </div>
      <div class="lg:col-span-5 lg:pl-4 lg:pt-14" data-reveal="right">
        <ContactInfoCard icon="phone" label="Phone" value={PHONE_DISPLAY} href={PHONE_HREF} />
        <ContactInfoCard icon="email" label="Email" value={EMAIL} href={`mailto:${EMAIL}`} />
        <ContactInfoCard icon="hours" label="Business Hours" value={HOURS} />
        <ContactInfoCard icon="area" label="Service Area" value={AREA} />
        <div class="pt-12">
          <span class="rule-champagne" aria-hidden="true"></span>
          <p class="t-h3 mt-6 text-ink">Ready for a detailed estimate?</p>
          <p class="mt-3 max-w-sm text-muted">Tell us about your space and get a quote within hours.</p>
          <div class="mt-6">
            <Button href={link('/quote/')} variant="link">Get a Free Quote</Button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-stone py-24 md:py-32">
    <Ornament variant="contour" class="inset-0 h-full w-full" />
    <div class="container-lux">
      <SectionHeader
        eyebrow="Where We Work"
        title="Our Service Area"
        lead="We serve Orlando and all surrounding communities throughout Central Florida."
      />
      <div class="mx-auto mt-16 max-w-5xl" data-reveal>
        <MapPlaceholder
          title="Service Area Map"
          text="Google Maps — Orlando, FL service area"
        />
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
