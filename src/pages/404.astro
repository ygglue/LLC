---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { link } from '../lib/site';
---

<BaseLayout
  title="Page not found | Luxury Duo Cleaning LLC"
  description="The page you requested could not be found."
  noindex
>
  <Nav slot="nav" />

  <section class="py-24 md:py-32 lg:py-40">
    <div class="container-lux flex flex-col items-center text-center" data-reveal>
      <p class="t-display t-italic text-gold" aria-hidden="true">404</p>
      <span class="rule-champagne mt-10" aria-hidden="true"></span>
      <h1 class="t-h1 mt-10 text-ink">Page not found</h1>
      <p class="t-lead mt-6 max-w-md">The page moved or never existed.</p>
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4">
        <Button href={link('/')} variant="outline">Back to Home</Button>
        <Button href={link('/quote/')} variant="primary">Get a Free Quote</Button>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
