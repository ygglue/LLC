---
import Ornament from '../components/Ornament.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
---

<BaseLayout
  title="Request a Free Quote | Luxury Duo Cleaning LLC Orlando FL"
  description="Get a free cleaning quote from Luxury Duo Cleaning LLC in Orlando FL. Construction, commercial, residential, Airbnb & deep cleaning — detailed estimates within hours."
>
  <Nav slot="nav" />

  <PageHero
    eyebrow="Free Quote"
    title="Request a Free Quote"
    lead="Tell us about your space and we'll get back to you with a detailed estimate within hours."
  />

  <section class="relative isolate overflow-hidden py-24 md:py-32">
    <Ornament variant="arcs" class="-left-48 top-0 w-[36rem] -scale-x-100 md:w-[46rem]" />
    <div class="container-lux">
      <div class="mx-auto max-w-3xl border border-line bg-paper p-6 sm:p-10 md:p-16" data-reveal>
        <QuoteForm />
        <hr class="hairline mt-12" />
        <p class="t-small mx-auto mt-8 max-w-md text-center text-muted">
          No obligation, no pressure. Your details stay private and are only used to prepare your estimate.
        </p>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
