---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Stat from '../components/Stat.astro';
import RoundCarousel from '../components/RoundCarousel.astro';
import CtaBand from '../components/CtaBand.astro';
import { link, PHONE_HREF } from '../lib/site';

import { Picture } from 'astro:assets';
import whyUs from '../assets/images/why-us.jpg';
import missionImg from '../assets/images/services/airbnb.jpg';
import { widthSet, cropSet, PICTURE_FORMATS } from '../lib/images';

// Portrait crop for the Mission column.
const missionCrop = cropSet(missionImg, 4 / 5, [400, 640, 900]);

---

<BaseLayout
  title="About Us | Luxury Duo Cleaning LLC Orlando FL"
  description="Learn about Luxury Duo Cleaning LLC — Orlando's precision cleaning company. Our mission, values, and commitment to quality work across Central Florida."
>
  <Nav slot="nav" />

  <PageHero
    eyebrow="About Us"
    title="Built on Precision. Driven by Results."
    lead="Luxury Duo Cleaning LLC was founded in Orlando with one goal: to become the cleaning company that contractors, businesses, and homeowners actually trust."
    imageSrc="images/services/residential.jpg"
    imageAlt="Robot vacuum gliding beneath a sofa in a bright Orlando living room"
  />

  <!-- Mission -->
  <section class="bg-stone">
    <div class="container-lux py-24 md:py-32 lg:py-40">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <SectionHeader align="left" number="01" eyebrow="Purpose" title="Our Mission" />
          <figure class="frame mt-12 w-full max-w-[440px] md:mt-16" data-reveal>
            <Picture
              src={missionImg}
              alt="Folded towels and guest amenities on light-wood shelves against a blush wall"
              formats={[...PICTURE_FORMATS]}
              fallbackFormat="jpg"
              width={missionCrop.width}
              height={missionCrop.height}
              widths={missionCrop.widths}
              fit="cover"
              sizes="(min-width: 1024px) 440px, (min-width: 488px) 440px, calc(100vw - 48px)"
              loading="lazy"
              decoding="async"
              class="block h-auto w-full"
              pictureAttributes={{ class: 'contents' }}
            />
          </figure>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 lg:pt-[4.25rem]" data-reveal>
          <p class="font-serif text-[1.625rem] font-normal leading-[1.4] text-ink md:text-[2rem]">
            To give every client a space that's truly clean — on schedule, to
            spec, and without the follow-up calls. Whether it's a job site
            before handover or your home before guests arrive, you should be
            able to count on us to get it right the first time.
          </p>
          <p class="mt-8 max-w-xl text-muted">
            That means clear quotes, crews that show up when promised, and the
            same precision and professionalism you expect from the contractors
            and businesses you already trust.
          </p>
        </div>
      </div>

      <div class="mt-20 grid border-t border-line sm:grid-cols-3 md:mt-28" data-reveal>
        <div class="border-b border-line py-10 sm:border-b-0 sm:pr-8">
          <Stat value="100%" label="Licensed & Insured" />
        </div>
        <div class="border-b border-line py-10 sm:border-b-0 sm:border-l sm:px-8 lg:px-12">
          <Stat value="Same-day" label="Quote Turnaround" />
        </div>
        <div class="py-10 sm:border-l sm:border-line sm:pl-8 lg:pl-12">
          <Stat value="Orlando" label="Serving All Areas" />
        </div>
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section class="bg-ivory">
    <div class="container-lux py-24 md:py-32 lg:py-40">
      <SectionHeader
        align="left"
        number="02"
        eyebrow="Principles"
        title="What Sets Us Apart"
        lead="Three principles that drive every job we take on."
      />
      <div class="mt-16 grid border-t border-line md:mt-20 md:grid-cols-3">
        {[
          {
            n: 'I',
            title: 'Efficiency',
            text: "We work fast without cutting corners. Contractor schedules don't wait, and neither do we. Every minute on-site is purposeful.",
          },
          {
            n: 'II',
            title: 'Reliability',
            text: 'We show up when we say we will. Consistent scheduling, consistent quality, consistent communication. No surprises.',
          },
          {
            n: 'III',
            title: 'Attention to Detail',
            text: 'We notice what others overlook. Baseboards, window tracks, grout lines — the details that make a space actually clean, not just tidy.',
          },
        ].map((p, i) => (
          <article
            class:list={[
              'py-10 md:py-12',
              i > 0 && 'border-t border-line md:border-t-0 md:border-l',
              i === 0 ? 'md:pr-10 lg:pr-14' : 'md:px-10 lg:px-14',
              i === 2 && 'md:pr-0 lg:pr-0',
            ]}
            data-reveal
            style={`transition-delay: ${i * 120}ms`}
          >
            <p class="t-italic text-2xl leading-none text-gold-deep" aria-hidden="true">{p.n}</p>
            <h3 class="t-h3 mt-8 text-ink">{p.title}</h3>
            <p class="mt-4 text-muted">{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Services strip -->
  <section class="bg-stone">
    <div class="container-lux py-24 md:py-32 lg:py-40">
      <SectionHeader
        align="left"
        number="03"
        eyebrow="Services"
        title="What We Do"
        lead="Six specialized cleaning services, each built for a different kind of client."
      />
      <div class="mt-16 md:mt-20" data-reveal>
        <RoundCarousel />
      </div>
    </div>
  </section>

  <!-- Our story -->
  <section class="bg-ivory">
    <div class="container-lux py-24 md:py-32 lg:py-40">
      <SectionHeader
        align="left"
        number="04"
        eyebrow="Heritage"
        title="Our Story"
        lead="From a single crew to a trusted Orlando cleaning partner."
      />
      <div class="mt-16 grid gap-12 md:mt-24 lg:grid-cols-12 lg:gap-16">
        <p class="t-italic text-[1.75rem] font-normal leading-[1.35] text-ink md:text-[2.25rem] lg:col-span-8 lg:col-start-2" data-reveal>
          Luxury Duo Cleaning LLC was started with a simple belief: that
          cleaning is a service business, and service means showing up,
          doing the work right, and earning the next job.
        </p>
        <div class="max-w-xl space-y-6 text-muted lg:col-span-5 lg:col-start-2 lg:self-center" data-reveal>
          <p>
            Based in Orlando, we started serving residential clients and
            quickly expanded into commercial and construction cleaning as
            contractors recognized the quality of our work. Today, we serve
            general contractors, property managers, Airbnb hosts, and
            homeowners across the greater Orlando area.
          </p>
          <p>
            We're still growing, and we're still hands-on. Every job gets the
            same attention to detail whether it's a single-family home or a
            large commercial buildout.
          </p>
        </div>
        <figure data-reveal class="group frame w-full max-w-[520px] lg:col-span-5 lg:col-start-8 lg:justify-self-end">
          <div class="overflow-hidden">
            <Picture
              src={whyUs}
              alt="Two-person Luxury Duo Cleaning crew wiping down a table in Orlando FL"
              formats={[...PICTURE_FORMATS]}
              fallbackFormat="jpg"
              widths={widthSet(whyUs, [400])}
              sizes="(min-width: 1024px) 460px, (min-width: 568px) 520px, calc(100vw - 48px)"
              loading="lazy"
              decoding="async"
              class="img-zoom aspect-[3/2] w-full object-cover"
              pictureAttributes={{ class: 'contents' }}
            />
          </div>
        </figure>
      </div>
    </div>
  </section>

  <CtaBand
    tone="stone"
    title="Ready for a Cleaner Space?"
    lead="Tell us about your property and we'll send a detailed estimate within hours."
    primaryHref={link('/quote/')}
    primaryLabel="Get a Free Quote"
    secondaryHref={PHONE_HREF}
    secondaryLabel="Call Now"
  />

  <Footer slot="footer" />
</BaseLayout>
