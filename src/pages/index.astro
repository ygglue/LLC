---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import ServicesCarousel from '../components/ServicesCarousel.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TrustBar from '../components/TrustBar.astro';
import ValueProp from '../components/ValueProp.astro';
import TestimonialsCarousel from '../components/TestimonialsCarousel.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { link, PHONE_HREF } from '../lib/site';

import { Picture } from 'astro:assets';
import whyUs from '../assets/images/why-us.jpg';
import { widthSet, PICTURE_FORMATS } from '../lib/images';


const cities = [
  'Orlando',
  'Winter Park',
  'Kissimmee',
  'Lake Nona',
  'Altamonte Springs',
  'Apopka',
  'Sanford',
  'Oviedo',
  'Maitland',
  'Casselberry',
  'Ocoee',
  'Windermere',
  'Lake Mary',
];
---

<BaseLayout
  title="Luxury Duo Cleaning LLC | Professional Cleaning Services Orlando FL"
  description="Orlando's detail-obsessed cleaning company. Pre & post-construction, commercial, residential, Airbnb, move-in/out & deep cleaning in Orlando FL. Licensed & insured."
>
  <Nav slot="nav" />

  <Hero
    title="Precision Cleaning. Zero Shortcuts."
    subtitle="Contractor-trusted cleaning for any area across Greater Orlando"
  />

  <TrustBar />

  <!-- The Services -->
  <section id="services" class="bg-ivory py-24 md:py-32 lg:py-40" aria-label="The services">
    <div class="container-lux">
      <SectionHeader
        align="left"
        number="01"
        eyebrow="The Services"
        title="One standard, six ways."
        lead="From the jobsite walkthrough to the guest who arrives tonight — every clean, finished with the same exacting care."
      />
    </div>
    <div class="mt-16 md:mt-20" data-reveal>
      <ServicesCarousel />
    </div>
  </section>

  <!-- Why Choose Us -->
  <section id="why-us" class="bg-stone py-24 md:py-32 lg:py-40" aria-label="Why choose Luxury Duo">
    <div class="container-lux grid items-center gap-16 lg:grid-cols-12 lg:gap-16">
      <figure class="frame mx-auto w-full max-w-[520px] lg:col-span-5 lg:mx-0 lg:mt-3" data-reveal>
        <Picture
          src={whyUs}
          alt="Two-person Luxury Duo Cleaning crew wiping down a table in Orlando FL"
          formats={[...PICTURE_FORMATS]}
          fallbackFormat="jpg"
          widths={widthSet(whyUs, [400])}
          sizes="(min-width: 1320px) 460px, (min-width: 1024px) 36vw, (min-width: 568px) 520px, calc(100vw - 48px)"
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
          pictureAttributes={{ class: 'contents' }}
        />
      </figure>

      <div class="lg:col-span-7 lg:pl-8">
        <SectionHeader
          align="left"
          number="02"
          eyebrow="Why Luxury Duo"
          title="Why Choose Luxury Duo"
          lead="We don't just clean spaces. We build relationships with contractors, businesses, and homeowners who demand consistency."
        />
        <div class="mt-16 grid gap-x-12 gap-y-12 sm:grid-cols-2" data-reveal>
          <ValueProp number="I" title="Attention to Detail" text="Every corner, every surface, every edge. We clean like it's our own space." />
          <ValueProp number="II" title="On-Time, Every Time" text="Contractor-friendly scheduling. We show up when we say we will." />
          <ValueProp number="III" title="Insured & Professional" text="Fully licensed and insured, with a background-checked team." />
          <ValueProp number="IV" title="Fast Response Times" text="Quotes within hours, not days. We move at your pace." />
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section id="testimonials" class="bg-ivory py-24 md:py-32 lg:py-40" aria-label="Testimonials">
    <div class="container-lux">
      <SectionHeader
        number="03"
        eyebrow="Testimonials"
        title="What Our Clients Say"
        lead="Trusted by contractors, property managers, and homeowners across Orlando."
      />
      <div class="mt-16 md:mt-20" data-reveal>
        <TestimonialsCarousel />
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section id="service-area" class="bg-stone py-24 md:py-32 lg:py-40" aria-label="Service area">
    <div class="container-lux grid items-start gap-16 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeader
          align="left"
          number="04"
          eyebrow="Service Area"
          title="Proudly Serving Central Florida"
          lead="Based in Orlando and on the road across the surrounding cities every day."
        />
        <ul class="mt-12 grid grid-cols-2 gap-x-8 border-t border-line sm:gap-x-12" aria-label="Cities we serve" data-reveal>
          {cities.map((city) => (
            <li class="border-b border-line py-3.5 font-serif text-[1.25rem] leading-snug text-ink">{city}</li>
          ))}
        </ul>
        <p class="mt-10 max-w-md text-muted" data-reveal>
          Don't see your neighborhood?
          <a href={link('/contact/')} class="text-ink underline decoration-champagne decoration-1 underline-offset-[6px] transition-colors duration-[600ms] hover:decoration-ink">Contact us</a>
          — if you're in Central Florida, we'll do our best to fit you in.
        </p>
      </div>
      <div class="lg:col-span-6 lg:pt-2" data-reveal>
        <MapPlaceholder title="Service Area Map" text="Google Maps — Orlando, FL service area" />
      </div>
    </div>
  </section>

  <CtaBand
    tone="stone"
    title="Ready to Work with Orlando's Most Detail-Oriented Cleaners?"
    primaryHref={link('/quote/')}
    primaryLabel="Get a Free Quote"
    secondaryHref={PHONE_HREF}
    secondaryLabel="Call Now"
  />

  <Footer slot="footer" />
</BaseLayout>
