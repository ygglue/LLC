---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import TrustBar from '../components/TrustBar.astro';
import ServiceCard from '../components/ServiceCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ValueProp from '../components/ValueProp.astro';
import ContactInfoCard from '../components/ContactInfoCard.astro';
import Stat from '../components/Stat.astro';
import ImageSlot from '../components/ImageSlot.astro';
import MapPlaceholder from '../components/MapPlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { link, PHONE_DISPLAY, PHONE_HREF, HOURS } from '../lib/site';

const base = import.meta.env.BASE_URL;

const swatches = [
  { name: 'Ivory', token: 'ivory', hex: '#F7F3EC', cls: 'bg-ivory', text: 'text-ink', note: 'Page background' },
  { name: 'Stone', token: 'stone', hex: '#EDE6DA', cls: 'bg-stone', text: 'text-ink', note: 'Alternate section' },
  { name: 'Paper', token: 'paper', hex: '#FCFAF6', cls: 'bg-paper', text: 'text-ink', note: 'Cards & forms' },
  { name: 'Ink', token: 'ink', hex: '#1E1B18', cls: 'bg-ink', text: 'text-on-dark', note: 'Text · dark surfaces · 15.5:1' },
  { name: 'Ink Soft', token: 'ink-soft', hex: '#3A342D', cls: 'bg-ink-soft', text: 'text-on-dark', note: 'Ink button hover' },
  { name: 'Muted', token: 'muted', hex: '#5E574E', cls: 'bg-muted', text: 'text-on-dark', note: 'Body copy · 6.44:1' },
  { name: 'Champagne', token: 'champagne', hex: '#B89A63', cls: 'bg-champagne', text: 'text-ink', note: 'Rules & frames · text on ink only' },
  { name: 'Gold', token: 'gold', hex: '#80612C', cls: 'bg-gold', text: 'text-on-dark', note: 'Gold text on light · 5.18:1' },
  { name: 'Gold Deep', token: 'gold-deep', hex: '#6E5326', cls: 'bg-gold-deep', text: 'text-on-dark', note: 'Gold on stone / hover' },
  { name: 'Line', token: 'line', hex: '#DCD2C1', cls: 'bg-line', text: 'text-ink', note: 'Decorative hairlines' },
  { name: 'Field', token: 'field', hex: '#8A8070', cls: 'bg-field', text: 'text-ink', note: 'Control borders · 3.51:1' },
  { name: 'Error', token: 'error', hex: '#9A2B23', cls: 'bg-error', text: 'text-on-dark', note: 'Validation · 6.92:1' },
  { name: 'On Dark Muted', token: 'on-dark-muted', hex: '#ADA597', cls: 'bg-on-dark-muted', text: 'text-ink', note: 'Secondary text on ink · 7.02:1' },
];

const typeScale = [
  { label: 't-display', cls: 't-display', spec: 'Cormorant 300 · clamp(3rem, 7vw, 6.5rem)', sample: 'Precision, quietly.' },
  { label: 't-h1', cls: 't-h1', spec: 'Cormorant 300 · clamp(2.5rem, 5vw, 4.5rem)', sample: 'Spaces, perfected.' },
  { label: 't-h2', cls: 't-h2', spec: 'Cormorant 400 · clamp(2rem, 3.6vw, 3.25rem)', sample: 'Why Choose Luxury Duo' },
  { label: 't-h3', cls: 't-h3', spec: 'Cormorant 400 · 1.75rem', sample: 'Pre & Post-Construction Cleaning' },
  { label: 't-h4', cls: 't-h4', spec: 'Inter 500 · 1rem · 0.02em', sample: 'Jake Rivera, Rivera General Contracting' },
  { label: 't-lead', cls: 't-lead', spec: 'Inter 400 · 1.125–1.25rem / 1.7 · muted', sample: 'Reliable, detail-obsessed cleaning for contractors, commercial properties, and homes across the Orlando area.' },
  { label: 'body', cls: 't-body text-muted', spec: 'Inter 400 · 1rem / 1.75', sample: 'Every corner, every surface, every edge — finished by hand and checked twice before we leave.' },
  { label: 't-small', cls: 't-small text-muted', spec: 'Inter 400 · 0.8125rem / 1.6', sample: 'We typically respond within a few hours during business days.' },
  { label: 't-eyebrow', cls: 't-eyebrow', spec: 'Inter 500 · 0.75rem · 0.24em · uppercase · gold', sample: "Orlando's Trusted Cleaning Partner" },
];

const swaps = [
  { slot: 'logo.svg — LD monogram', draft: 'Draft SVG monogram + DRAFT LOGO pill', real: 'Real logo artwork' },
  { slot: 'hero.svg', draft: 'Draft hero illustration', real: 'Commercial-space photo' },
  { slot: 'construction.svg', draft: 'Draft job-site illustration', real: 'Job-site photo' },
  { slot: 'commercial.svg', draft: 'Draft illustration', real: 'Real commercial photo' },
  { slot: 'residential.svg', draft: 'Draft illustration', real: 'Real residential photo' },
  { slot: 'airbnb.svg', draft: 'Draft illustration', real: 'Real rental photo' },
  { slot: 'movein.svg', draft: 'Draft illustration', real: 'Real move-in/out photo' },
  { slot: 'deep.svg', draft: 'Draft illustration', real: 'Real deep-clean photo' },
  { slot: 'Testimonials', draft: 'Sample copy', real: 'Google reviews' },
  { slot: 'Phone', draft: '(407) 555-1234 placeholder', real: 'Real phone number' },
  { slot: 'Formspree', draft: 'Stub mode (no network)', real: 'Live endpoint' },
  { slot: 'Map', draft: 'Draft map placeholder', real: 'Google Maps embed' },
  { slot: 'Instagram', draft: '"#" placeholder link', real: 'Real Instagram URL' },
];
---

<BaseLayout
  noindex
  title="Design System | Luxury Duo Cleaning LLC"
  description="Internal style tile and component gallery for the Luxury Duo Cleaning marketing site. Not linked in navigation."
>
  <Nav slot="nav" />

  <PageHero
    eyebrow="Internal"
    title="Design Tile & Component Gallery"
    lead="Style reference for the preview build. This page is not linked in site navigation."
  />

  <div class="container-lux py-24 md:py-32">
    <!-- 01 Colour -->
    <section data-reveal>
      <p class="flex items-baseline gap-4"><span class="t-italic text-xl leading-none text-gold">01</span><span class="t-eyebrow">Tokens</span></p>
      <h2 class="t-h2 mt-4 text-ink">Colour</h2>
      <p class="t-lead mt-4 max-w-2xl">Ivory &amp; champagne. Champagne never carries text on light surfaces — use gold or gold-deep instead.</p>
      <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 md:gap-6 lg:grid-cols-4">
        {swatches.map((s) => (
          <div class="border border-line bg-paper">
            <div class={`${s.cls} ${s.text} flex h-28 items-end p-4 font-mono text-xs tracking-wide`}>{s.hex}</div>
            <div class="px-4 py-4">
              <p class="t-h4 text-ink">{s.name}</p>
              <p class="mt-1 font-mono text-xs text-muted">{s.token}</p>
              <p class="t-small mt-2 text-muted">{s.note}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 02 Type -->
    <section class="mt-24 md:mt-32" data-reveal>
      <p class="flex items-baseline gap-4"><span class="t-italic text-xl leading-none text-gold">02</span><span class="t-eyebrow">Typography</span></p>
      <h2 class="t-h2 mt-4 text-ink">Type Scale</h2>
      <p class="t-lead mt-4 max-w-2xl">Cormorant Garamond for display, Inter for everything that must be read quickly. Never Cormorant 300 below 1.5rem.</p>
      <div class="mt-12 border-t border-line">
        {typeScale.map((t) => (
          <div class="grid gap-4 border-b border-line py-8 md:grid-cols-12 md:gap-8">
            <div class="md:col-span-3">
              <p class="font-mono text-xs text-ink">.{t.label}</p>
              <p class="t-small mt-1 text-muted">{t.spec}</p>
            </div>
            <p class={`${t.cls} min-w-0 break-words text-ink md:col-span-9`}>{t.sample}</p>
          </div>
        ))}
        <div class="grid gap-4 border-b border-line py-8 md:grid-cols-12 md:gap-8">
          <div class="md:col-span-3">
            <p class="font-mono text-xs text-ink">.t-italic</p>
            <p class="t-small mt-1 text-muted">Cormorant italic · one emphasised word / pull quotes</p>
          </div>
          <p class="t-h2 text-ink md:col-span-9">Precision Cleaning. <em class="t-italic">Zero Shortcuts.</em></p>
        </div>
      </div>
    </section>

    <!-- 03 Buttons -->
    <section class="mt-24 md:mt-32" data-reveal>
      <p class="flex items-baseline gap-4"><span class="t-italic text-xl leading-none text-gold">03</span><span class="t-eyebrow">Actions</span></p>
      <h2 class="t-h2 mt-4 text-ink">Buttons &amp; Links</h2>
      <div class="mt-12 grid gap-px border border-line bg-line lg:grid-cols-2">
        <div class="flex flex-col gap-8 bg-ivory p-8 md:p-12">
          <p class="t-eyebrow">On light</p>
          <div class="flex flex-wrap gap-4">
            <Button href={link('/quote/')} variant="primary">Primary</Button>
            <Button href={link('/quote/')} variant="outline">Outline</Button>
          </div>
          <div class="flex flex-wrap items-center gap-4">
            <Button href={link('/quote/')} variant="primary" size="sm">Small</Button>
            <Button href={link('/quote/')} variant="primary" size="lg">Large</Button>
          </div>
          <Button href={link('/quote/')} variant="primary" block>Block</Button>
          <div class="flex flex-wrap items-center gap-8">
            <Button href={link('/quote/')} variant="link">Link Lux</Button>
            <a href={link('/contact/')} class="link-lux-ink">Link Lux Ink</a>
          </div>
        </div>
        <div class="flex flex-col gap-8 bg-ink p-8 md:p-12" data-dark>
          <p class="t-eyebrow">On dark</p>
          <div class="flex flex-wrap gap-4">
            <Button href={link('/quote/')} variant="light">On Dark</Button>
            <Button href={link('/quote/')} variant="outline-light">Outline On Dark</Button>
          </div>
          <p class="t-lead">Champagne fill with ink text (6.40:1); focus rings switch to champagne inside <code class="font-mono text-sm">[data-dark]</code>.</p>
        </div>
      </div>
    </section>

    <!-- 04 Forms -->
    <section class="mt-24 md:mt-32" data-reveal>
      <p class="flex items-baseline gap-4"><span class="t-italic text-xl leading-none text-gold">04</span><span class="t-eyebrow">Input</span></p>
      <h2 class="t-h2 mt-4 text-ink">Form Fields</h2>
      <p class="t-lead mt-4 max-w-2xl">Text inputs are a single underline; selects and textareas take a full hairline box. Errors use <code class="font-mono text-base">aria-invalid</code>.</p>
      <div class="mt-12 grid gap-10 border border-line bg-paper p-6 sm:p-10 md:grid-cols-2 md:gap-x-12 md:p-14">
        <div>
          <label class="field-label mb-1" for="demo-name">Name *</label>
          <input class="field" type="text" id="demo-name" placeholder="Your name" />
        </div>
        <div>
          <label class="field-label mb-1" for="demo-email">Email *</label>
          <input class="field" type="email" id="demo-email" value="not-an-email" aria-invalid="true" aria-describedby="demo-email-error" />
          <p id="demo-email-error" class="field-error mt-2">Please enter a valid email.</p>
        </div>
        <div>
          <label class="field-label mb-3" for="demo-select">Service</label>
          <select class="field" id="demo-select">
            <option>Residential Cleaning</option>
            <option>Commercial Cleaning</option>
          </select>
        </div>
        <div>
          <label class="field-label mb-3" for="demo-select-err">Property Type *</label>
          <select class="field" id="demo-select-err" aria-invalid="true" aria-describedby="demo-select-err-error">
            <option value="">Select property type</option>
          </select>
          <p id="demo-select-err-error" class="field-error mt-2">Please select a property type.</p>
        </div>
        <div class="md:col-span-2">
          <label class="field-label mb-3" for="demo-textarea">Message</label>
          <textarea class="field" id="demo-textarea" rows="4" placeholder="How can we help?"></textarea>
        </div>
      </div>
    </section>

    <!-- 05 Lines -->
    <section class="mt-24 md:mt-32" data-reveal>
      <p class="flex items-baseline gap-4"><span class="t-italic text-xl leading-none text-gold">05</span><span class="t-eyebrow">Detail</span></p>
      <h2 class="t-h2 mt-4 text-ink">Hairlines &amp; Frames</h2>
      <div class="mt-12 grid items-center gap-16 md:grid-cols-2">
        <div class="flex flex-col gap-10">
          <div>
            <p class="font-mono text-xs text-ink">.rule-champagne</p>
            <span class="rule-champagne mt-4" aria-hidden="true"></span>
          </div>
          <div>
            <p class="font-mono text-xs text-ink">.hairline</p>
            <hr class="hairline mt-4" />
          </div>
          <div>
            <p class="font-mono text-xs text-ink">--radius-card · 2px &nbsp;·&nbsp; --shadow-soft (sticky header only)</p>
          </div>
        </div>
        <div class="mx-auto w-full max-w-xs p-3 md:p-6">
          <div class="frame">
            <div class="aspect-[4/5] w-full bg-stone"></div>
          </div>
          <p class="mt-6 font-mono text-xs text-ink md:mt-8">.frame — champagne outline</p>
        </div>
      </div>
    </section>

    <!-- 06 Components -->
    <section class="mt-24 md:mt-32" data-reveal>
      <p class="flex items-baseline gap-4"><span class="t-italic text-xl leading-none text-gold">06</span><span class="t-eyebrow">Gallery</span></p>
      <h2 class="t-h2 mt-4 text-ink">Components</h2>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">TrustBar</h3>
      <div class="mt-6 overflow-hidden border border-line">
        <TrustBar />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">ServiceCard — Normal + Flagship</h3>
      <div class="mt-6 grid gap-8 md:grid-cols-2">
        <ServiceCard
          title="Commercial Cleaning"
          desc="Offices, retail spaces, warehouses, and facilities cleaned on your schedule."
          href={`${base}services/#commercial`}
          imageSrc={`${base}draft/commercial.svg`}
          imageAlt="Commercial office cleaning sample"
        />
        <ServiceCard
          title="Pre & Post-Construction Cleaning"
          desc="Final-detail polish that gets your project signed off on the walkthrough."
          href={`${base}services/#construction`}
          imageSrc={`${base}draft/construction.svg`}
          imageAlt="Post-construction cleaning sample"
          flagship
        />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">TestimonialCard</h3>
      <div class="mt-6 grid max-w-2xl gap-6">
        <TestimonialCard
          quote="We've used Luxury Duo for three post-construction cleanups now. They're fast, thorough, and always on schedule."
          name="Jake Rivera"
          role="Rivera General Contracting"
          initials="JR"
        />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">ValueProp</h3>
      <div class="mt-6 grid max-w-2xl gap-6">
        <ValueProp icon="detail" title="Attention to Detail" text="Every corner, every surface, every edge." />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">ContactInfoCard</h3>
      <div class="mt-6 max-w-md">
        <ContactInfoCard icon="phone" label="Phone" value={PHONE_DISPLAY} href={PHONE_HREF} />
        <ContactInfoCard icon="hours" label="Business Hours" value={HOURS} />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">Stat</h3>
      <div class="mt-6 grid max-w-xl grid-cols-3 gap-6 border border-line bg-stone p-8">
        <Stat value="100%" label="Licensed & Insured" />
        <Stat value="24hr" label="Quote Turnaround" />
        <Stat value="Orlando" label="Serving All Areas" />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">ImageSlot</h3>
      <div class="mt-6 max-w-2xl">
        <ImageSlot slotId="sample-slot" src={`${base}draft/hero.svg`} alt="Sample draft image slot" aspect="16/9" />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">MapPlaceholder</h3>
      <div class="mt-6 max-w-3xl">
        <MapPlaceholder />
      </div>
    </section>

    <section class="mt-16" data-reveal>
      <h3 class="t-h3 text-ink">CtaBand</h3>
      <div class="mt-6 overflow-hidden">
        <CtaBand
          title="Sample CTA Band"
          primaryHref={link('/quote/')}
          primaryLabel="Request a Free Quote"
          secondaryHref={link('/contact/')}
          secondaryLabel="Talk to Us"
        />
      </div>
    </section>

    <section class="mt-24 md:mt-32" data-reveal>
      <p class="flex items-baseline gap-4"><span class="t-italic text-xl leading-none text-gold">07</span><span class="t-eyebrow">Pre-launch</span></p>
      <h2 class="t-h2 mt-4 text-ink">Placeholder Swap Table</h2>
      <div class="mt-12 overflow-x-auto border border-line">
        <table class="w-full min-w-[640px] border-collapse bg-paper text-left text-sm">
          <thead>
            <tr class="bg-stone">
              <th class="t-eyebrow border-b border-line px-5 py-4 text-ink">Slot</th>
              <th class="t-eyebrow border-b border-line px-5 py-4 text-ink">Draft Now</th>
              <th class="t-eyebrow border-b border-line px-5 py-4 text-ink">Real Asset Needed</th>
            </tr>
          </thead>
          <tbody>
            {swaps.map((row) => (
              <tr class="border-b border-line last:border-0">
                <td class="px-5 py-4 font-mono text-xs text-ink">{row.slot}</td>
                <td class="px-5 py-4 text-muted">{row.draft}</td>
                <td class="px-5 py-4 text-ink">{row.real}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
