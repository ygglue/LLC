---
/**
 * Decorative line-art for section backgrounds. Thin champagne strokes at low
 * opacity: visible texture, never competing with content. Always aria-hidden.
 *
 * Place inside a `relative overflow-hidden` section and position with `class`,
 * e.g. <Ornament variant="arcs" class="-right-40 -top-40 w-[36rem]" />.
 */
interface Props {
  variant: 'arcs' | 'fan' | 'contour' | 'monogram' | 'sprig' | 'grid' | 'wreath';
  /** Positioning / sizing utilities (absolute is applied for you). */
  class?: string;
  /** Surface the ornament sits on; dark surfaces need a lower opacity. */
  tone?: 'light' | 'dark';
  /** Fade the strokes out toward one side so they stay clear of text there. */
  fade?: 'left' | 'top' | 'right' | 'none';
}

const { variant, class: cls = '', tone = 'light', fade = 'none' } = Astro.props;

const range = (n: number, f: (i: number) => number) => Array.from({ length: n }, (_, i) => f(i));
// Fan rays fanning across a half circle, centred at the bottom middle.
const rays = range(19, (i) => (Math.PI * i) / 18);
// Sprig leaves along a gentle curve: [x, y, rotation, length]
const leaves: [number, number, number, number][] = [
  [62, 360, -38, 34], [96, 346, 42, 32], [92, 300, -46, 36], [130, 288, 36, 34],
  [124, 240, -50, 38], [164, 232, 30, 36], [160, 182, -54, 36], [196, 180, 26, 34],
  [198, 132, -58, 34], [230, 132, 20, 30], [236, 88, -62, 30], [262, 88, 14, 26],
];

// Laurel wreath: two branches rising from a tie at the bottom, open at the top.
// Angles in degrees, screen space (0° = right, 90° = down).
const W = { cx: 200, cy: 200, r: 138 };
const pt = (deg: number, r = W.r) => {
  const a = (deg * Math.PI) / 180;
  return [W.cx + Math.cos(a) * r, W.cy + Math.sin(a) * r] as const;
};
const arc = (from: number, to: number) => {
  const [x1, y1] = pt(from);
  const [x2, y2] = pt(to);
  const sweep = to > from ? 1 : 0;
  return `M ${x1.toFixed(1)} ${y1.toFixed(1)} A ${W.r} ${W.r} 0 0 ${sweep} ${x2.toFixed(1)} ${y2.toFixed(1)}`;
};
// Each branch: stem angles and leaves alternating outside/inside the stem,
// tilted toward the growing tip and shrinking slightly as they climb.
type Leaf = { x: number; y: number; rot: number; rx: number };
const branch = (from: number, to: number) => {
  const dir = Math.sign(to - from);
  const leaves: Leaf[] = [];
  const steps = 11;
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const deg = from + (to - from) * (0.06 + t * 0.9);
    const size = 17 - t * 6;
    for (const side of [1, -1]) {
      const [x, y] = pt(deg, W.r + side * (size * 0.62));
      const tangent = deg + 90 * dir;
      leaves.push({ x, y, rot: tangent - side * dir * 32, rx: size });
    }
  }
  const [tx, ty] = pt(to + dir * 3);
  leaves.push({ x: tx, y: ty, rot: to + 90 * dir, rx: 11 });
  return { stem: arc(from, to), leaves };
};
const wreath = [branch(100, 252), branch(80, -72)];
const berries = [150, 205, 240, 30, -25, -60].map((d) => pt(d, W.r - 4));
---

<svg
  class:list={['ornament pointer-events-none absolute -z-10 select-none text-champagne', tone === 'dark' ? 'ornament-dark' : 'ornament-light', fade === 'left' && 'ornament-fade-left', fade === 'top' && 'ornament-fade-top', fade === 'right' && 'ornament-fade-right', cls]}
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  {...(variant === 'arcs' && { viewBox: '0 0 600 600' })}
  {...(variant === 'fan' && { viewBox: '0 0 800 420' })}
  {...(variant === 'contour' && { viewBox: '0 0 1200 600', preserveAspectRatio: 'none' })}
  {...(variant === 'monogram' && { viewBox: '0 0 600 420' })}
  {...(variant === 'sprig' && { viewBox: '0 0 320 420' })}
  {...(variant === 'grid' && { viewBox: '0 0 400 400' })}
  {...(variant === 'wreath' && { viewBox: '0 0 400 400' })}
>
  {variant === 'wreath' && (
    <g stroke-linecap="round">
      {wreath.map((b) => (
        <>
          <path d={b.stem} vector-effect="non-scaling-stroke" />
          {b.leaves.map((l) => (
            <g transform={`rotate(${l.rot.toFixed(1)} ${l.x.toFixed(1)} ${l.y.toFixed(1)})`}>
              <ellipse cx={l.x.toFixed(1)} cy={l.y.toFixed(1)} rx={l.rx.toFixed(1)} ry={(l.rx * 0.36).toFixed(1)} vector-effect="non-scaling-stroke" />
              <line x1={(l.x - l.rx * 0.8).toFixed(1)} y1={l.y.toFixed(1)} x2={(l.x + l.rx * 0.8).toFixed(1)} y2={l.y.toFixed(1)} vector-effect="non-scaling-stroke" />
            </g>
          ))}
        </>
      ))}
      {berries.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="3.2" vector-effect="non-scaling-stroke" />)}
      <!-- Ribbon tie where the branches meet -->
      <path d="M 186 336 C 178 352, 170 362, 158 372 M 214 336 C 222 352, 230 362, 242 372" vector-effect="non-scaling-stroke" />
      <ellipse cx="200" cy="338" rx="9" ry="6" vector-effect="non-scaling-stroke" />
    </g>
  )}
  {variant === 'arcs' && range(10, (i) => 60 + i * 56).map((r) => <circle cx="600" cy="0" r={r} vector-effect="non-scaling-stroke" />)}

  {variant === 'fan' && (
    <g vector-effect="non-scaling-stroke">
      {rays.map((a) => (
        <line x1="400" y1="420" x2={400 + Math.cos(a) * 400} y2={420 - Math.sin(a) * 400} vector-effect="non-scaling-stroke" />
      ))}
      {[120, 220, 320, 400].map((r) => (
        <path d={`M ${400 - r} 420 A ${r} ${r} 0 0 1 ${400 + r} 420`} vector-effect="non-scaling-stroke" />
      ))}
    </g>
  )}

  {variant === 'contour' &&
    range(9, (i) => i).map((i) => {
      const y = 60 + i * 60;
      const a = 26 + (i % 3) * 8;
      return (
        <path
          d={`M -20 ${y} C 180 ${y - a}, 340 ${y + a}, 560 ${y} S 900 ${y - a * 1.4}, 1220 ${y + a * 0.6}`}
          vector-effect="non-scaling-stroke"
        />
      );
    })}

  {variant === 'monogram' && (
    <text
      x="300"
      y="330"
      text-anchor="middle"
      font-family="Cormorant Garamond, Georgia, serif"
      font-size="380"
      font-weight="300"
      letter-spacing="-8"
      vector-effect="non-scaling-stroke"
    >LD</text>
  )}

  {variant === 'sprig' && (
    <g>
      <path d="M 40 410 C 90 330, 150 230, 268 60" vector-effect="non-scaling-stroke" />
      {leaves.map(([x, y, r, l]) => (
        <ellipse cx={x} cy={y} rx={l / 2} ry={l / 5.5} transform={`rotate(${r} ${x} ${y})`} vector-effect="non-scaling-stroke" />
      ))}
    </g>
  )}

  {variant === 'grid' && (
    <g>
      {range(9, (i) => i * 50).map((p) => (
        <>
          <line x1={p} y1="0" x2={p} y2="400" vector-effect="non-scaling-stroke" />
          <line x1="0" y1={p} x2="400" y2={p} vector-effect="non-scaling-stroke" />
        </>
      ))}
      <circle cx="200" cy="200" r="150" vector-effect="non-scaling-stroke" />
      <line x1="0" y1="0" x2="400" y2="400" vector-effect="non-scaling-stroke" />
      <line x1="400" y1="0" x2="0" y2="400" vector-effect="non-scaling-stroke" />
    </g>
  )}
</svg>

<style>
  /* Low contrast but visible: champagne strokes ≈1.4–1.7:1 against the surface. */
  .ornament-light {
    opacity: 0.55;
  }
  .ornament-dark {
    opacity: 0.16;
  }
  /* Clear on the left (where copy and list rules sit), full strength on the right.
     Below lg the copy stacks full-width above the map, so fade top → bottom
     instead and let the lines show only around the map. */
  .ornament-fade-left {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, transparent 68%, #000 88%);
    mask-image: linear-gradient(to bottom, transparent 0%, transparent 68%, #000 88%);
  }
  /* Anchored to the right edge: strongest at the edge, gone before mid-section. */
  .ornament-fade-right {
    -webkit-mask-image: linear-gradient(to left, #000 25%, transparent 80%);
    mask-image: linear-gradient(to left, #000 25%, transparent 80%);
  }
  /* Keep only the lower band of the shape (below centred copy and buttons). */
  .ornament-fade-top {
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, transparent 64%, #000 94%);
    mask-image: linear-gradient(to bottom, transparent 0%, transparent 64%, #000 94%);
  }
  @media (min-width: 1024px) {
    .ornament-fade-left {
      -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 38%, #000 72%);
      mask-image: linear-gradient(to right, transparent 0%, transparent 38%, #000 72%);
    }
  }
</style>
