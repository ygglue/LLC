---
import { Picture } from 'astro:assets';
import { link } from '../lib/site';
import { resolveImage, cropSet, PICTURE_FORMATS } from '../lib/images.ts';

interface Props {
  title: string;
  subtitle: string;
  eyebrow?: string;
}

const { title, subtitle, eyebrow = 'Orlando · Central Florida' } = Astro.props;

// "Precision Cleaning. Zero Shortcuts." → the second sentence is set in italic.
const split = title.indexOf('. ');
const lead = split > -1 ? title.slice(0, split + 1) : title;
const emphasis = split > -1 ? title.slice(split + 2) : '';

const IMAGE = 'images/services/airbnb.jpg';
const IMAGE_ALT = 'Fresh folded towels and soap amenities set out for guests — Airbnb turnover cleaning in Orlando FL';
const meta = resolveImage(IMAGE);
const crop = meta ? cropSet(meta, 4 / 5, [480, 640, 800, 1000]) : undefined;
const base = import.meta.env.BASE_URL;
---

<section class="hero bg-ivory pb-24 pt-10 md:pb-32 md:pt-16 lg:pb-40" aria-label="Introduction">
  <div class="container-lux grid items-center gap-16 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <span class="rule-champagne mb-8" aria-hidden="true"></span>
      <p class="t-eyebrow">{eyebrow}</p>
      <h1 class="hero-title t-display mt-8 text-ink">
        <span class="block">{lead}</span>
        {emphasis && <em class="t-italic block font-normal text-ink">{emphasis}</em>}
      </h1>
      <p class="t-lead mt-8 max-w-md md:mt-10">{subtitle}</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-10 gap-y-6 md:mt-12">
        <a href={link('/quote/')} class="btn btn-primary">Get a Free Quote</a>
        <a href={link('/contact/')} class="link-lux-ink">Contact Us</a>
      </div>
    </div>

    <div class="lg:col-span-5">
      <figure class="frame mx-auto max-w-[520px] lg:ml-auto lg:mr-3">
        <div class="aspect-[4/5] overflow-hidden bg-stone">
          {meta && crop ? (
            <Picture
              src={meta}
              alt={IMAGE_ALT}
              formats={[...PICTURE_FORMATS]}
              fallbackFormat="jpg"
              width={crop.width}
              height={crop.height}
              widths={crop.widths}
              sizes="(min-width: 1320px) 480px, (min-width: 1024px) 36vw, (min-width: 568px) 520px, calc(100vw - 48px)"
              fit="cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full object-cover"
              pictureAttributes={{ class: 'contents' }}
            />
          ) : (
            <img
              src={`${base}${IMAGE}`}
              alt={IMAGE_ALT}
              width="800"
              height="1000"
              loading="eager"
              fetchpriority="high"
              class="h-full w-full object-cover"
            />
          )}
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  /* Seven columns at 1440 can't hold a 6.5rem line; cap the size on desktop so
     each sentence sits on its own line. */
  @media (min-width: 1024px) {
    .hero-title {
      font-size: clamp(3.75rem, 5.6vw, 5.75rem);
    }
  }
</style>
