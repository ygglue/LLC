---
/**
 * ContactInfoCard — editorial contact line: eyebrow label over a serif value,
 * closed by a hairline. `icon` is kept for API compatibility but not rendered.
 * Pass `href` (tel:/mailto:) to make the value a link.
 */
interface Props {
  icon?: 'phone' | 'email' | 'hours' | 'area';
  label: string;
  value: string;
  href?: string;
}

const { label, value, href } = Astro.props;
---

<div class="border-b border-line py-7 first:pt-0">
  <p class="t-eyebrow">{label}</p>
  {href ? (
    <a href={href} class="info-value t-h3 mt-3 inline-block break-words text-ink">
      {value}
    </a>
  ) : (
    <p class="info-value t-h3 mt-3 break-words text-ink">{value}</p>
  )}
</div>

<style>
  .info-value {
    font-size: 1.5rem;
  }
  @media (min-width: 640px) {
    .info-value {
      font-size: 1.75rem;
    }
  }
  a.info-value {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-base) var(--ease-lux);
  }
  a.info-value:hover,
  a.info-value:focus-visible {
    text-decoration-color: var(--color-champagne);
  }
</style>
