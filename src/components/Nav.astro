---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { link, PHONE_DISPLAY, PHONE_HREF, EMAIL } from '../lib/site';

const current = Astro.url.pathname;
function normalize(p: string): string {
  if (p.length > 1 && p.endsWith('/')) return p.slice(0, -1);
  return p;
}
function isActive(path: string): boolean {
  return normalize(current) === normalize(link(path));
}

const links = [
  { path: '/', label: 'Home' },
  { path: '/about/', label: 'About' },
  { path: '/services/', label: 'Services' },
  { path: '/contact/', label: 'Contact' },
];
const quoteLink = { href: link('/quote/'), label: 'Get a Free Quote' };
const contactLinks = [
  { href: PHONE_HREF, label: PHONE_DISPLAY, kind: 'Call' },
  { href: `mailto:${EMAIL}`, label: EMAIL, kind: 'Email' },
];
---

<header id="site-header" class="site-header sticky top-0 z-50">
  <nav class="container-lux flex h-[var(--nav-height)] items-center justify-between gap-6" aria-label="Main navigation">
    <div id="site-logo" class="site-logo">
      <Logo />
    </div>

    <div class="flex items-center gap-8 lg:gap-12">
      <a id="header-cta" href={quoteLink.href} class="header-cta link-lux-ink hidden md:inline-flex">Get a Free Quote</a>

      <button
        id="menu-btn"
        type="button"
        class="menu-btn relative z-50 -mr-2 inline-flex min-h-11 items-center gap-4 px-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="menu-overlay"
      >
        <span class="menu-btn-text" aria-hidden="true">
          <span class="menu-btn-word" data-word="menu">Menu</span>
          <span class="menu-btn-word" data-word="close">Close</span>
        </span>
        <span class="menu-lines" aria-hidden="true">
          <span class="menu-line"></span>
          <span class="menu-line"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<div
  id="menu-overlay"
  data-lenis-prevent
  class="fixed inset-0 z-40 flex flex-col overflow-y-auto bg-ink text-on-dark"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
  data-dark
  hidden
>
  <nav class="container-lux my-auto pb-16 pt-[calc(var(--nav-height)+3rem)]" aria-label="Fullscreen menu">
    <ul class="flex flex-col">
      {links.map((l, i) => (
        <li class="menu-item" style={`--d:${150 + i * 90}ms`}>
          <a
            href={link(l.path)}
            aria-current={isActive(l.path) ? 'page' : undefined}
            class="menu-link group inline-flex items-baseline gap-5 py-1 sm:gap-8"
          >
            <span class="menu-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="menu-label">{l.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="menu-item mt-12 sm:mt-16" style="--d:540ms">
      <hr class="hairline" />
      <div class="mt-10 flex flex-col items-start gap-8 md:flex-row md:items-center md:justify-between">
        <Button href={quoteLink.href} variant="light">{quoteLink.label}</Button>
        <ul class="flex flex-col gap-2 sm:flex-row sm:gap-x-10">
          {contactLinks.map((l) => (
            <li>
              <a
                href={l.href}
                aria-label={`${l.kind}: ${l.label}`}
                class="inline-flex min-h-11 items-center text-[0.9375rem] tracking-[0.02em] text-on-dark-muted transition-colors duration-[600ms] hover:text-on-dark"
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </nav>
</div>

<script>
  // Delegated + once-guarded: survives Astro view-transition page swaps
  // (direct bindings would point at detached nodes after navigation).
  if (!window.__menuNavInit) {
    window.__menuNavInit = true;

    const CLOSE_MS = 600;
    const getBtn = () => document.getElementById('menu-btn');
    const getOverlay = () => document.getElementById('menu-overlay');
    const getHeader = () => document.getElementById('site-header');
    const isOpen = () => getBtn()?.getAttribute('aria-expanded') === 'true';
    let hideTimer = null;

    // ---- Header "scrolled" state ----
    let scrollTicking = false;
    function updateScrolled() {
      scrollTicking = false;
      const header = getHeader();
      if (header) header.toggleAttribute('data-scrolled', window.scrollY > 8);
    }
    window.addEventListener(
      'scroll',
      () => {
        if (!scrollTicking) {
          scrollTicking = true;
          requestAnimationFrame(updateScrolled);
        }
      },
      { passive: true }
    );

    // ---- Modal helpers ----
    function setBackgroundInert(on) {
      document.querySelectorAll('#main, footer, #site-logo, #header-cta').forEach((el) => {
        if (on) el.setAttribute('inert', '');
        else el.removeAttribute('inert');
      });
    }
    function focusables() {
      const overlay = getOverlay();
      const links = overlay ? Array.from(overlay.querySelectorAll('a[href]')) : [];
      const btn = getBtn();
      return btn ? [btn, ...links] : links;
    }

    function setOpen(open, { returnFocus = true } = {}) {
      const btn = getBtn();
      const overlay = getOverlay();
      const header = getHeader();
      if (!btn || !overlay) return;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      btn.dataset.open = open ? 'true' : 'false';
      header?.toggleAttribute('data-menu-open', open);
      if (hideTimer) {
        clearTimeout(hideTimer);
        hideTimer = null;
      }
      if (open) {
        overlay.removeAttribute('hidden');
        document.documentElement.classList.add('menu-scroll-lock');
        setBackgroundInert(true);
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            overlay.classList.add('open');
            overlay.querySelector('a[href]')?.focus({ preventScroll: true });
          })
        );
      } else {
        overlay.classList.remove('open');
        document.documentElement.classList.remove('menu-scroll-lock');
        setBackgroundInert(false);
        if (returnFocus) btn.focus({ preventScroll: true });
        hideTimer = setTimeout(() => {
          hideTimer = null;
          const current = getOverlay();
          if (current && !current.classList.contains('open')) current.setAttribute('hidden', '');
        }, CLOSE_MS + 50);
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;
      if (target.closest('#menu-btn')) {
        setOpen(!isOpen());
        return;
      }
      if (target.closest('#menu-overlay a') && isOpen()) setOpen(false);
    });

    document.addEventListener('keydown', (e) => {
      if (!isOpen()) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
        return;
      }
      if (e.key !== 'Tab') return;
      const items = focusables();
      if (!items.length) return;
      const idx = items.indexOf(document.activeElement);
      e.preventDefault();
      let next;
      if (idx === -1) next = e.shiftKey ? items.length - 1 : 1 % items.length;
      else next = (idx + (e.shiftKey ? -1 : 1) + items.length) % items.length;
      items[next].focus();
    });

    function resetMenu() {
      if (hideTimer) {
        clearTimeout(hideTimer);
        hideTimer = null;
      }
      document.documentElement.classList.remove('menu-scroll-lock');
      setBackgroundInert(false);
      getHeader()?.removeAttribute('data-menu-open');
      const overlay = getOverlay();
      if (overlay) {
        overlay.classList.remove('open');
        overlay.setAttribute('hidden', '');
      }
      const btn = getBtn();
      if (btn) {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open menu');
        btn.dataset.open = 'false';
      }
    }
    // Clean up before the old page is swapped out, and never land on a new
    // page with scroll locked or a stale open menu.
    document.addEventListener('astro:before-swap', resetMenu);
    document.addEventListener('astro:page-load', () => {
      resetMenu();
      updateScrolled();
    });
  }
</script>

<style is:global>
  html {
    scrollbar-gutter: stable;
  }
  html.menu-scroll-lock {
    overflow: hidden;
  }
</style>

<style>
  /* ---- Sticky header: transparent at top, frosted ivory once scrolled ---- */
  .site-header {
    transition:
      background-color var(--dur-base) var(--ease-lux),
      box-shadow var(--dur-base) var(--ease-lux);
  }
  .site-header[data-scrolled]:not([data-menu-open]) {
    background-color: rgb(247 243 236 / 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow:
      inset 0 -1px 0 var(--color-line),
      var(--shadow-soft);
  }
  /* While the menu is open the overlay sits under the header: let it show. */
  .site-header[data-menu-open] {
    pointer-events: none;
  }
  .site-header[data-menu-open] #menu-btn {
    pointer-events: auto;
  }
  .site-logo,
  .header-cta {
    transition: opacity var(--dur-base) var(--ease-lux);
  }
  .site-header[data-menu-open] .site-logo,
  .site-header[data-menu-open] .header-cta {
    opacity: 0;
  }

  /* ---- Menu button: a word and two hairlines that cross into an X ---- */
  .menu-btn {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink);
    transition: color var(--dur-base) var(--ease-lux);
  }
  .site-header[data-menu-open] .menu-btn {
    color: var(--color-on-dark);
  }
  .site-header[data-menu-open] .menu-btn:focus-visible {
    outline-color: var(--color-champagne);
  }
  .menu-btn-text {
    display: inline-grid;
    text-align: right;
  }
  .menu-btn-word {
    grid-area: 1 / 1;
    transition: opacity var(--dur-fast) var(--ease-lux);
  }
  .menu-btn-word[data-word="close"],
  #menu-btn[data-open="true"] .menu-btn-word[data-word="menu"] {
    opacity: 0;
  }
  #menu-btn[data-open="true"] .menu-btn-word[data-word="close"] {
    opacity: 1;
  }
  .menu-lines {
    position: relative;
    display: block;
    width: 24px;
    height: 7px;
  }
  .menu-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition:
      transform var(--dur-base) var(--ease-lux),
      top var(--dur-base) var(--ease-lux);
  }
  .menu-line:first-child {
    top: 0;
  }
  .menu-line:last-child {
    top: 6px;
  }
  #menu-btn[data-open="true"] .menu-line:first-child {
    top: 3px;
    transform: rotate(45deg);
  }
  #menu-btn[data-open="true"] .menu-line:last-child {
    top: 3px;
    transform: rotate(-45deg);
  }

  /* ---- Overlay: a slow ink fade ---- */
  #menu-overlay[hidden] {
    display: none;
  }
  #menu-overlay {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-base) var(--ease-lux),
      visibility 0s linear var(--dur-base);
  }
  #menu-overlay.open {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-base) var(--ease-lux),
      visibility 0s linear 0s;
  }
  #menu-overlay .menu-item {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity var(--dur-base) var(--ease-lux),
      transform var(--dur-base) var(--ease-lux);
    transition-delay: 0ms;
  }
  #menu-overlay.open .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: var(--d, 0ms);
  }

  .menu-link {
    color: var(--color-on-dark);
    text-decoration: none;
  }
  .menu-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-champagne);
    min-width: 1.75rem;
  }
  .menu-label {
    display: inline-block;
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1.12;
    transition:
      color var(--dur-base) var(--ease-lux),
      transform var(--dur-base) var(--ease-lux);
  }
  .menu-link:hover .menu-label,
  .menu-link:focus-visible .menu-label {
    color: var(--color-champagne);
  }
  .menu-link:hover .menu-label {
    transform: translateX(0.5rem);
  }
  .menu-link[aria-current="page"] .menu-label {
    font-style: italic;
    font-weight: 400;
    color: var(--color-champagne);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .menu-btn,
    .menu-line,
    .menu-btn-word,
    .menu-label,
    #menu-overlay,
    #menu-overlay .menu-item {
      transition: none !important;
    }
    .menu-link:hover .menu-label {
      transform: none;
    }
  }
</style>
