---
import Logo from './Logo.astro';
import { SITE_NAME, PHONE_DISPLAY, PHONE_HREF, EMAIL, AREA, INSTAGRAM, link } from '../lib/site';

const services = [
  { anchor: '#construction', label: 'Pre & Post-Construction' },
  { anchor: '#commercial', label: 'Commercial Cleaning' },
  { anchor: '#residential', label: 'Residential Cleaning' },
  { anchor: '#airbnb', label: 'Airbnb / Vacation Rental' },
  { anchor: '#movein', label: 'Move-In / Move-Out' },
  { anchor: '#deep', label: 'Deep Cleaning' },
];

const company = [
  { path: '/', label: 'Home' },
  { path: '/about/', label: 'About Us' },
  { path: '/services/', label: 'All Services' },
  { path: '/quote/', label: 'Get a Free Quote' },
  { path: '/contact/', label: 'Contact Us' },
];

const linkCls = 'text-[0.9375rem] text-on-dark-muted transition-colors duration-[600ms] hover:text-on-dark';
const hasInstagram = INSTAGRAM && INSTAGRAM !== '#';
---

<footer class="bg-ink text-on-dark" data-dark>
  <div class="container-lux">
    <!-- Closing line -->
    <div class="flex flex-col gap-10 py-24 md:flex-row md:items-end md:justify-between md:py-32" data-reveal>
      <p class="t-h2 max-w-2xl text-on-dark md:text-[3.5rem]">
        Spaces, <em class="t-italic font-normal">quietly</em> perfected.
      </p>
      <a href={link('/quote/')} class="btn btn-on-dark shrink-0 self-start md:self-auto">Get a Free Quote</a>
    </div>

    <hr class="hairline" />

    <!-- Directory -->
    <div class="grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] lg:gap-16 lg:py-20">
      <div>
        <Logo tone="ivory" />
        <p class="mt-6 max-w-xs text-[0.9375rem] leading-relaxed text-on-dark-muted">
          Precision cleaning for contractors, commercial properties, and homeowners across the Orlando area.
        </p>
      </div>

      <nav aria-label="Services">
        <h3 class="t-eyebrow">Services</h3>
        <ul class="mt-6 space-y-3">
          {services.map((s) => (
            <li>
              <a href={`${link('/services/')}${s.anchor}`} class={linkCls}>{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Company">
        <h3 class="t-eyebrow">Company</h3>
        <ul class="mt-6 space-y-3">
          {company.map((c) => (
            <li>
              <a href={link(c.path)} class={linkCls}>{c.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h3 class="t-eyebrow">Contact</h3>
        <ul class="mt-6 space-y-3">
          <li><a href={PHONE_HREF} class={linkCls}>{PHONE_DISPLAY}</a></li>
          <li><a href={`mailto:${EMAIL}`} class={`${linkCls} break-all`}>{EMAIL}</a></li>
          <li class="text-[0.9375rem] text-on-dark-muted">{AREA}</li>
        </ul>
      </div>
    </div>

    <hr class="hairline" />

    <div class="flex flex-col gap-4 py-8 sm:flex-row sm:items-center sm:justify-between">
      <span class="t-small text-on-dark-muted">&copy; 2026 {SITE_NAME}. All rights reserved.</span>
      {hasInstagram && (
        <a href={INSTAGRAM} class="t-small uppercase tracking-[0.2em] text-on-dark-muted transition-colors duration-[600ms] hover:text-on-dark">
          Instagram
        </a>
      )}
    </div>
  </div>
</footer>
