---
interface Props {
  quote: string;
  name: string;
  role: string;
  /** Accepted for compatibility; avatars are no longer shown. */
  initials?: string;
}

const { quote, name, role } = Astro.props;
const stars = [0, 1, 2, 3, 4];
---

<figure class="flex flex-col items-center text-center">
  <span class="quote-mark block font-serif text-[4rem] leading-[0.6] text-champagne" aria-hidden="true">&ldquo;</span>
  <blockquote class="t-italic mt-6 text-[1.5rem] font-normal leading-[1.4] text-ink md:text-[2rem] md:leading-[1.35]">
    {quote}
  </blockquote>
  <div class="mt-10 flex gap-1.5 text-champagne" role="img" aria-label="Rated 5 out of 5 stars">
    {stars.map(() => (
      <svg viewBox="0 0 24 24" class="h-3 w-3 fill-current" aria-hidden="true">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
      </svg>
    ))}
  </div>
  <figcaption class="mt-5">
    <span class="t-h4 block text-ink">{name}</span>
    <span class="t-small mt-1 block text-muted">{role}</span>
  </figcaption>
</figure>
