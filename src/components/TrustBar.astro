---
const items = ['Licensed & Insured', 'Background-Checked Staff', 'Satisfaction Guaranteed', 'Serving All of Orlando'];
---

<section class="border-y border-line bg-stone" aria-label="Why trust us">
  <div class="container-lux py-8 md:py-10" data-reveal>
    <ul class="grid grid-cols-2 gap-x-6 gap-y-5 text-center md:grid-cols-4 xl:flex xl:flex-nowrap xl:items-center xl:justify-center xl:gap-x-0">
      {items.map((item, i) => (
        <li class="t-eyebrow flex items-center justify-center text-ink xl:whitespace-nowrap">
          {i > 0 && (
            <span class="mx-7 hidden text-[0.5rem] text-champagne xl:inline" aria-hidden="true">◆</span>
          )}
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
