---
/* ContactForm — STUB mode (no network). Real Formspree wired post-signoff. */
const inputCls = 'field';
const labelCls = 'field-label mb-1';
const errorCls = 'field-error mt-2';
---

<div data-reveal data-form-wrap="contact">
  <form id="contact-form" method="post" novalidate class="flex flex-col gap-9">
    <div>
      <label class={labelCls} for="contact-name">Name *</label>
      <input
        class={inputCls}
        type="text"
        id="contact-name"
        name="name"
        placeholder="Your name"
        required
        autocomplete="name"
        aria-describedby="contact-name-error"
      />
      <p id="contact-name-error" class={errorCls} hidden>Please enter your name.</p>
    </div>

    <div class="grid gap-9 sm:grid-cols-2 sm:gap-x-10">
      <div>
        <label class={labelCls} for="contact-email">Email *</label>
        <input
          class={inputCls}
          type="email"
          id="contact-email"
          name="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
          aria-describedby="contact-email-error"
        />
        <p id="contact-email-error" class={errorCls} hidden>Please enter a valid email.</p>
      </div>
      <div>
        <label class={labelCls} for="contact-phone">Phone</label>
        <input
          class={inputCls}
          type="tel"
          id="contact-phone"
          name="phone"
          placeholder="(407) 555-1234"
          autocomplete="tel"
          aria-describedby="contact-phone-error"
        />
        <p id="contact-phone-error" class={errorCls} hidden>Please enter a valid phone number.</p>
      </div>
    </div>

    <div>
      <label class:list={[labelCls, 'mb-3']} for="contact-subject">Subject *</label>
      <select
        class={inputCls}
        id="contact-subject"
        name="subject"
        required
        aria-describedby="contact-subject-error"
      >
        <option value="" disabled selected>Select a topic</option>
        <option value="general">General Inquiry</option>
        <option value="quote">Request a Quote</option>
        <option value="scheduling">Scheduling Question</option>
        <option value="feedback">Feedback</option>
        <option value="other">Other</option>
      </select>
      <p id="contact-subject-error" class={errorCls} hidden>Please select a topic.</p>
    </div>

    <div>
      <label class:list={[labelCls, 'mb-3']} for="contact-message">Message *</label>
      <textarea
        class={inputCls}
        id="contact-message"
        name="message"
        rows="5"
        placeholder="How can we help?"
        required
        aria-describedby="contact-message-error"
      ></textarea>
      <p id="contact-message-error" class={errorCls} hidden>Please enter a message.</p>
    </div>

    <div class="mt-2 flex flex-col gap-5">
      <button type="submit" class="btn btn-primary w-full">Send Message</button>
      <p class="t-small text-center text-muted">
        We typically respond within a few hours during business days.
      </p>
    </div>
  </form>

  <div
    id="contact-success"
    hidden
    tabindex="-1"
    class="form-success flex-col items-center border border-line bg-paper px-6 py-14 text-center sm:px-10 sm:py-16"
    role="status"
  >
    <span class="rule-champagne" aria-hidden="true"></span>
    <p class="t-eyebrow mt-6">Received</p>
    <h3 class="t-h2 mt-4 text-ink">Thanks — message received!</h3>
    <p class="mx-auto mt-5 max-w-md text-muted">
      Preview mode — not sending. Real Formspree wired post-signoff.
    </p>
  </div>
</div>

<script>
  function initContact() {
    const form = document.getElementById('contact-form');
    if (!form || form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';
    const wrap = form.closest('[data-form-wrap="contact"]');
    const success = wrap ? wrap.querySelector('#contact-success') : document.getElementById('contact-success');

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const PHONE_RE = /^[+\d][\d\s().-]{5,}$/;

    function setError(input, hasError) {
      if (!input) return;
      const err = document.getElementById(input.id + '-error');
      input.setAttribute('aria-invalid', hasError ? 'true' : 'false');
      if (err) {
        if (hasError) err.removeAttribute('hidden');
        else err.setAttribute('hidden', '');
      }
    }

    function validateField(input) {
      const val = input.value.trim();
      const id = input.id;
      if (id === 'contact-email') {
        const bad = val === '' || !EMAIL_RE.test(val);
        setError(input, bad);
        return !bad;
      }
      if (id === 'contact-phone') {
        if (val === '') {
          setError(input, false);
          return true;
        }
        const digits = val.replace(/\D/g, '');
        const bad = !PHONE_RE.test(val) || digits.length < 7;
        setError(input, bad);
        return !bad;
      }
      const bad = val === '';
      setError(input, bad);
      return !bad;
    }

    ['contact-name', 'contact-email', 'contact-phone', 'contact-subject', 'contact-message'].forEach((id) => {
      const el = document.getElementById(id);
      el?.addEventListener('input', () => setError(el, false));
      el?.addEventListener('change', () => setError(el, false));
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const ids = ['contact-name', 'contact-email', 'contact-subject', 'contact-message'];
      let firstInvalid = null;
      ids.forEach((id) => {
        const el = document.getElementById(id);
        if (!el) return;
        const ok = validateField(el);
        if (!ok && !firstInvalid) firstInvalid = el;
      });
      // Phone: validate only if filled
      const phone = document.getElementById('contact-phone');
      if (phone && phone.value.trim() !== '') {
        const ok = validateField(phone);
        if (!ok && !firstInvalid) firstInvalid = phone;
      }
      if (firstInvalid) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        firstInvalid.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        firstInvalid.focus({ preventScroll: true });
        return;
      }
      // STUB mode: no network — show success panel
      form.setAttribute('hidden', '');
      if (success) {
        success.removeAttribute('hidden');
        success.scrollIntoView({ block: 'center' });
        success.focus({ preventScroll: true });
      }
    });
  }
  initContact();
  document.addEventListener('astro:page-load', initContact);
</script>

<style>
  .form-success:not([hidden]) {
    display: flex;
  }
  /* Programmatic focus target (tabindex=-1), not a control: no ring */
  .form-success:focus,
  .form-success:focus-visible {
    outline: none;
  }
  /* Fields signal focus with a 2px ink rule (global.css), not a box outline */
  .field:focus-visible {
    outline: none;
  }
  /* Placeholder option reads as a hint, not a value */
  select.field:has(option[value='']:checked) {
    color: var(--color-muted);
  }
  select.field option {
    color: var(--color-ink);
  }
</style>
