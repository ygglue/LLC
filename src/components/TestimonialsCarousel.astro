---
import { TESTIMONIALS } from '../lib/testimonials.ts';
import TestimonialCard from './TestimonialCard.astro';

// One quote at a time, crossfading in place.
const total = TESTIMONIALS.length;
const pad = (n: number) => String(n).padStart(2, '0');

const arrowBtn =
  'inline-flex h-11 w-11 shrink-0 items-center justify-center border border-field text-ink transition-colors duration-[600ms] hover:border-ink hover:bg-ink hover:text-ivory';
---

<div
  data-carousel="testimonials"
  class="mx-auto max-w-3xl"
  role="region"
  aria-roledescription="carousel"
  aria-label="Client reviews"
>
  <div class="grid">
    {TESTIMONIALS.map((t, gi) => (
      <div
        data-group={String(gi)}
        role="group"
        aria-roledescription="slide"
        aria-label={`Review ${gi + 1} of ${total}`}
        class:list={['t-slide [grid-area:1/1]', gi === 0 ? 'is-active' : '']}
        inert={gi !== 0 ? true : undefined}
        aria-hidden={gi !== 0 ? 'true' : undefined}
      >
        <TestimonialCard quote={t.quote} name={t.name} role={t.role} initials={t.initials} />
      </div>
    ))}
  </div>

  {total > 1 && (
    <div class="mt-14 flex items-center justify-center gap-8">
      <button type="button" data-prev aria-label="Previous review" class={arrowBtn}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14.5 6.5L9 12l5.5 5.5" />
        </svg>
      </button>

      <p class="t-eyebrow min-w-[5.5rem] text-center tabular-nums text-ink" aria-hidden="true">
        <span data-counter>{pad(1)}</span>
        <span class="mx-2 text-field">/</span>
        <span>{pad(total)}</span>
      </p>

      <button type="button" data-next aria-label="Next review" class={arrowBtn}>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9.5 6.5L15 12l-5.5 5.5" />
        </svg>
      </button>
    </div>
  )}
  <p data-status class="sr-only" aria-live="polite"></p>
</div>

<script>
  let cleanups: Array<() => void> = [];

  function initTestimonials() {
    cleanups.forEach((fn) => fn());
    cleanups = [];

    document.querySelectorAll<HTMLElement>('[data-carousel="testimonials"]').forEach((root) => {
      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-group]'));
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');
      const counter = root.querySelector<HTMLElement>('[data-counter]');
      const status = root.querySelector<HTMLElement>('[data-status]');
      const total = slides.length;
      if (total < 2) return;
      let index = 0;

      const show = (i: number, announce = true) => {
        index = ((i % total) + total) % total;
        slides.forEach((s, si) => {
          const active = si === index;
          s.classList.toggle('is-active', active);
          s.inert = !active;
          if (active) s.removeAttribute('aria-hidden');
          else s.setAttribute('aria-hidden', 'true');
        });
        if (counter) counter.textContent = String(index + 1).padStart(2, '0');
        if (status && announce) status.textContent = `Showing review ${index + 1} of ${total}`;
      };

      const onPrev = () => show(index - 1);
      const onNext = () => show(index + 1);
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') onPrev();
        else if (e.key === 'ArrowRight') onNext();
      };

      prev?.addEventListener('click', onPrev);
      next?.addEventListener('click', onNext);
      root.addEventListener('keydown', onKey);
      show(0, false);

      cleanups.push(() => {
        prev?.removeEventListener('click', onPrev);
        next?.removeEventListener('click', onNext);
        root.removeEventListener('keydown', onKey);
      });
    });
  }

  document.addEventListener('astro:page-load', initTestimonials);
  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>

<style>
  /* All slides share one grid cell (height = tallest quote) and crossfade. */
  .t-slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-slow) var(--ease-lux),
      visibility 0s linear var(--dur-slow);
  }
  .t-slide.is-active {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-slow) var(--ease-lux) 200ms,
      visibility 0s linear 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .t-slide,
    .t-slide.is-active {
      transition: none;
    }
  }
</style>
