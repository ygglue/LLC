---
import { Picture } from 'astro:assets';
import { SERVICES } from '../lib/services.ts';
import { resolveImage, cropSet, PICTURE_FORMATS } from '../lib/images.ts';

const base = import.meta.env.BASE_URL;
const COUNT = SERVICES.length;

// 44px square hairline controls (field border = 3.5:1 on ivory)
const ctrl =
  'inline-flex h-11 w-11 shrink-0 items-center justify-center border border-field text-ink transition-colors duration-[600ms] ease-[var(--ease-lux)] hover:border-ink hover:bg-ink hover:text-ivory';
---

<div
  data-carousel="round"
  data-count={String(COUNT)}
  data-drift="18"
  role="region"
  aria-roledescription="carousel"
  aria-label="Our cleaning services"
>
  <div data-viewport class="select-none">
    <div data-track class="flex items-start gap-6 will-change-transform md:gap-8">
      {SERVICES.map((service, i) => (
        <article
          data-slide={String(i)}
          data-title={service.title}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${COUNT}`}
          class="group flex w-60 shrink-0 flex-col sm:w-72"
        >
          <div class="overflow-hidden bg-stone" style="aspect-ratio: 4/5">
            {(() => {
              const cls = 'img-zoom pointer-events-none h-full w-full object-cover';
              const meta = resolveImage(service.image);
              if (!meta) {
                return (
                  <img
                    src={`${base}${service.image}`}
                    alt={service.imageAlt}
                    loading="lazy"
                    decoding="async"
                    width="288"
                    height="360"
                    draggable="false"
                    class={cls}
                  />
                );
              }
              // Slides are 240px (288px at sm+); 640px covers 2x DPR
              const crop = cropSet(meta, 4 / 5, [320, 480, 640]);
              return (
                <Picture
                  src={meta}
                  alt={service.imageAlt}
                  formats={[...PICTURE_FORMATS]}
                  fallbackFormat="jpg"
                  width={crop.width}
                  height={crop.height}
                  widths={crop.widths.filter((w) => w <= 640)}
                  sizes="(min-width: 640px) 288px, 240px"
                  fit="cover"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class={cls}
                  pictureAttributes={{ class: 'contents' }}
                />
              );
            })()}
          </div>
          <p class="t-italic mt-6 text-lg leading-none text-gold" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 font-serif text-2xl leading-tight text-ink">{service.title}</h3>
          <a href={`${base}services/#${service.slug}`} draggable="false" class="link-lux mt-4 self-start">
            Learn more <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
  </div>

  <div data-js-only class="invisible mt-10 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-line pt-6 sm:gap-6">
    <div class="flex min-w-0 items-center">
      <button
        type="button"
        data-toggle
        aria-label="Pause automatic slide show"
        data-state="playing"
        class="mr-1 inline-flex h-11 w-11 items-center sm:mr-2 justify-center text-ink transition-colors hover:text-gold"
      >
        <svg data-icon-pause aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M9 5v14M15 5v14" /></svg>
        <svg data-icon-play aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"><path d="M8 5l11 7-11 7z" /></svg>
      </button>
      <div class="flex items-center">
        {SERVICES.map((service, i) => (
          <button
            type="button"
            data-dot={String(i)}
            aria-label={`Show ${service.title}`}
            aria-current={i === 0 ? 'true' : undefined}
            class="inline-flex h-11 items-center px-1 sm:px-1.5"
          >
            <span class="dot-mark block h-px w-4 bg-field sm:w-6"></span>
          </button>
        ))}
      </div>
    </div>
    <div class="flex items-center gap-2 sm:gap-3">
      <button type="button" data-prev aria-label="Previous service" class={ctrl}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
      </button>
      <button type="button" data-next aria-label="Next service" class={ctrl}>
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg>
      </button>
    </div>
  </div>
  <p data-status class="sr-only" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import { registerStrips } from '../scripts/strip.ts';
  registerStrips('[data-carousel="round"]');
</script>

<style>
  /* Pre-init / no-JS: a native swipeable row showing card 1 first */
  [data-carousel="round"] [data-viewport] {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  [data-carousel="round"] [data-viewport]::-webkit-scrollbar {
    display: none;
  }
  [data-carousel="round"] [data-slide] {
    scroll-snap-align: start;
  }
  /* Engine running: clipped strip, vertical page scroll stays native */
  [data-carousel="round"][data-ready] [data-viewport] {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
    cursor: grab;
  }
  [data-carousel="round"][data-ready] [data-viewport]:active {
    cursor: grabbing;
  }
  [data-carousel="round"] [data-track] {
    transition: transform 0.9s var(--ease-lux);
  }
  [data-carousel="round"] [data-track].no-anim {
    transition: none !important;
  }
  /* Dots as hairline bars: inactive 24px field, active 48px ink */
  [data-carousel="round"] .dot-mark {
    transition:
      width var(--dur-base) var(--ease-lux),
      background-color var(--dur-base) var(--ease-lux);
  }
  [data-carousel="round"] [data-dot][aria-current="true"] .dot-mark {
    width: 2rem;
    background-color: var(--color-ink);
  }
  @media (min-width: 640px) {
    [data-carousel="round"] [data-dot][aria-current="true"] .dot-mark {
      width: 3rem;
    }
  }
  [data-carousel="round"] [data-dot]:hover:not([aria-current="true"]) .dot-mark {
    background-color: var(--color-muted);
  }
  [data-carousel="round"] [data-toggle][data-state="playing"] [data-icon-play],
  [data-carousel="round"] [data-toggle][data-state="paused"] [data-icon-pause] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-carousel="round"] [data-track],
    [data-carousel="round"] .dot-mark {
      transition: none !important;
    }
  }
</style>
