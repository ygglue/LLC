---
interface Props {
  title: string;
  desc: string;
  href: string;
  imageSrc: string;
  imageAlt: string;
  flagship?: boolean;
  delay?: number;
  hideDesc?: boolean;
  center?: boolean;
}

const { title, desc, href, imageSrc, imageAlt, flagship = false, delay = 0, hideDesc = false, center = false } =
  Astro.props;
---

<article
  data-reveal
  style={`transition-delay: ${delay}ms`}
  class:list={['group flex flex-1 flex-col', center && 'items-center text-center']}
>
  <div class="w-full overflow-hidden bg-stone" style="aspect-ratio: 4/5">
    <img src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" width="600" height="750" class="img-zoom h-full w-full object-cover" />
  </div>
  <div class:list={['mt-6 flex flex-col', center ? 'items-center' : 'items-start']}>
    {flagship && <p class="t-eyebrow mb-3">Signature</p>}
    <h3 class="t-h3 text-ink">{title}</h3>
    {!hideDesc && desc && <p class="mt-3 max-w-md text-muted">{desc}</p>}
    <a href={href} class="link-lux mt-5">
      Discover <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
