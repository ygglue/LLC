---
import { Picture } from 'astro:assets';
import { SERVICES, FLAGSHIP_SLUG } from '../lib/services.ts';
import { resolveImage, cropSet, PICTURE_FORMATS } from '../lib/images.ts';

const base = import.meta.env.BASE_URL;

// Slides are fixed-width 4:5 cards: clamp(240px, 26vw, 380px)
const SLIDE_SIZES = '(min-width: 1462px) 380px, (min-width: 924px) 26vw, 240px';

// Home-only photo overrides (services page keeps the shared images from services.ts)
const HOME_IMAGES: Record<string, { image: string; imageAlt: string }> = {
  construction: {
    image: 'images/services/home-construction.webp',
    imageAlt: 'Crew in hard hats detailing windows and floors — post-construction cleaning in Orlando FL',
  },
  commercial: {
    image: 'images/services/home-commercial.webp',
    imageAlt: 'Cleaning team vacuuming and mopping an office — commercial cleaning in Orlando FL',
  },
  residential: {
    image: 'images/services/home-residential.webp',
    imageAlt: 'Broom sweeping a wood floor — residential cleaning in Orlando FL',
  },
  airbnb: {
    image: 'images/services/home-airbnb.webp',
    imageAlt: 'Cleaner carrying a caddy of spray bottles — Airbnb turnover cleaning in Orlando FL',
  },
  movein: {
    image: 'images/services/home-movein.webp',
    imageAlt: 'Moving boxes with a broom ready — move-in move-out cleaning in Orlando FL',
  },
  deep: {
    image: 'images/services/home-deep.webp',
    imageAlt: 'Hands in yellow rubber gloves with spray bottle and sponge — deep cleaning in Orlando FL',
  },
};

const COUNT = SERVICES.length;

const btn =
  'inline-flex h-11 w-11 items-center justify-center border border-field text-ink transition-colors duration-[600ms] hover:border-ink hover:bg-ink hover:text-ivory';
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
  data-carousel="services"
  data-count={String(COUNT)}
  data-drift="18"
  role="region"
  aria-roledescription="carousel"
  aria-label="Our cleaning services"
>
  <div data-viewport class="svc-viewport relative w-full select-none">
    <div data-track class="flex items-start gap-6 will-change-transform">
      {SERVICES.map((service, i) => (
        <article
          data-slide={String(i)}
          data-title={service.title}
          role="group"
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${COUNT}`}
          class="svc-slide group shrink-0"
        >
          <div class="relative aspect-[4/5] overflow-hidden bg-stone">
            {(() => {
              const path = HOME_IMAGES[service.slug]?.image ?? service.image;
              const alt = HOME_IMAGES[service.slug]?.imageAlt ?? service.imageAlt;
              const cls = 'img-zoom pointer-events-none absolute inset-0 h-full w-full object-cover';
              const meta = resolveImage(path);
              if (!meta) {
                return (
                  <img
                    src={`${base}${path}`}
                    alt={alt}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    width="800"
                    height="1000"
                    draggable="false"
                    class={cls}
                  />
                );
              }
              const crop = cropSet(meta, 4 / 5, [240, 380, 480, 640, 760]);
              return (
                <Picture
                  src={meta}
                  alt={alt}
                  formats={[...PICTURE_FORMATS]}
                  fallbackFormat="jpg"
                  width={crop.width}
                  height={crop.height}
                  widths={crop.widths}
                  sizes={SLIDE_SIZES}
                  fit="cover"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                  class={cls}
                  pictureAttributes={{ class: 'contents' }}
                />
              );
            })()}
          </div>
          <div class="pt-6">
            <p class="flex items-baseline gap-4">
              <span class="t-italic text-lg leading-none text-gold" aria-hidden="true">{pad(i + 1)}</span>
              {service.slug === FLAGSHIP_SLUG && <span class="t-eyebrow">Signature</span>}
            </p>
            <h3 class="svc-title mt-4 font-serif text-[1.625rem] font-normal leading-[1.15] text-ink">{service.title}</h3>
            <a
              href={`${base}services/#${service.slug}`}
              draggable="false"
              class="link-lux mt-4"
              aria-label={`Discover ${service.title}`}
            >
              Discover
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div data-js-only class="container-lux invisible mt-12 flex items-center gap-3">
    <button type="button" data-prev aria-label="Previous service" class={btn}>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 6.5L9 12l5.5 5.5" /></svg>
    </button>
    <button type="button" data-next aria-label="Next service" class={btn}>
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 6.5L15 12l-5.5 5.5" /></svg>
    </button>
    <button type="button" data-toggle aria-label="Pause automatic slide show" data-state="playing" class={btn}>
      <svg data-icon-pause aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1"><path d="M9 6.5v11M15 6.5v11" /></svg>
      <svg data-icon-play aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="round"><path d="M8.5 6v12l9.5-6z" /></svg>
    </button>
  </div>

  <p data-status class="sr-only" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import { registerStrips } from '../scripts/strip.ts';
  registerStrips('[data-carousel="services"]');
</script>

<style>
  /* Cards start on the container's left edge and bleed off the right. */
  .svc-viewport {
    --svc-inset: 1.5rem;
    padding-left: var(--svc-inset);
    scroll-padding-left: var(--svc-inset);
  }
  @media (min-width: 768px) {
    .svc-viewport {
      --svc-inset: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .svc-viewport {
      --svc-inset: max(4rem, calc((100% - 1320px) / 2 + 4rem));
    }
  }
  .svc-slide {
    width: clamp(240px, 26vw, 380px);
  }
  .svc-title {
    min-height: 2.3em;
  }
  /* Pre-init / no-JS: a native swipeable row showing slide 1 first */
  [data-carousel="services"] [data-viewport] {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  [data-carousel="services"] [data-viewport]::-webkit-scrollbar {
    display: none;
  }
  [data-carousel="services"] [data-slide] {
    scroll-snap-align: start;
  }
  /* Engine running: clipped strip, vertical page scroll stays native */
  [data-carousel="services"][data-ready] [data-viewport] {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y;
    cursor: grab;
  }
  [data-carousel="services"][data-ready] [data-viewport]:active {
    cursor: grabbing;
  }
  [data-carousel="services"] [data-track] {
    transition: transform 0.9s var(--ease-lux);
  }
  [data-carousel="services"] [data-track].no-anim {
    transition: none !important;
  }
  [data-carousel="services"] [data-track].dragging img {
    transform: none !important;
  }
  [data-carousel="services"] [data-toggle][data-state="playing"] [data-icon-play],
  [data-carousel="services"] [data-toggle][data-state="paused"] [data-icon-pause] {
    display: none;
  }
  [data-carousel="services"] [data-toggle][hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-carousel="services"] [data-track] {
      transition: none !important;
    }
  }
</style>
