---
interface Props {
  /** Accepted for compatibility; the luxury layout uses numerals, not icons. */
  icon?: 'detail' | 'clock' | 'shield' | 'bolt';
  /** Optional numeral shown above the title, e.g. "I" or "01". */
  number?: string;
  title: string;
  text: string;
}

const { number, title, text } = Astro.props;
---

<div class="border-t border-line pt-8">
  {number && <span class="t-italic block text-lg leading-none text-gold" aria-hidden="true">{number}</span>}
  <h3 class:list={['t-h3 text-ink', number && 'mt-5']}>{title}</h3>
  <p class="mt-3 text-muted">{text}</p>
</div>
