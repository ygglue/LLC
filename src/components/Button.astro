---
/**
 * Button — thin wrapper over the global .btn / .link-lux classes (global.css).
 * - primary / dark:            .btn-primary         ink fill, ivory text (15.5:1) — light surfaces
 * - outline:                   .btn-outline         ink hairline border → ink fill on hover
 * - light / secondary:         .btn-on-dark         champagne fill, ink text (6.40:1) — dark surfaces
 * - outline-light:             .btn-outline-on-dark ivory border + text → ivory fill on hover
 * - link:                      .link-lux            gold uppercase text link with drawn underline
 * Sizes change padding only (height stays >= 52px for .btn variants).
 */
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'light' | 'outline-light' | 'secondary' | 'dark' | 'link';
  size?: 'lg' | 'md' | 'sm';
  block?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', block = false, class: extra = '' } = Astro.props;

const variants: Record<string, string> = {
  primary: 'btn btn-primary',
  dark: 'btn btn-primary',
  outline: 'btn btn-outline',
  light: 'btn btn-on-dark',
  secondary: 'btn btn-on-dark',
  'outline-light': 'btn btn-outline-on-dark',
  link: 'link-lux',
};
const sizes: Record<string, string> = {
  lg: 'px-10',
  md: '',
  sm: 'px-6',
};
const isLink = variant === 'link';
const classes = [
  variants[variant] ?? variants.primary,
  isLink ? '' : sizes[size],
  block && !isLink ? 'w-full' : '',
  extra,
]
  .filter(Boolean)
  .join(' ');
---

<a href={href} class={classes}>
  <slot />
</a>
